{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xsmb://schema/full27_v1",
  "title": "XSMB FULL_27 Draw Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "calendar_state", "prizes"],
  "properties": {
    "schema_version": {"const": "FULL_27_V1"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "calendar_state": {"enum": ["DRAW_CONFIRMED"]},
    "prizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DB", "G1", "G2", "G3", "G4", "G5", "G6", "G7"],
      "properties": {
        "DB": {"type": "string", "pattern": "^\\d{5}$"},
        "G1": {"type": "string", "pattern": "^\\d{5}$"},
        "G2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^\\d{5}$"}},
        "G3": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "pattern": "^\\d{5}$"}},
        "G4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "pattern": "^\\d{4}$"}},
        "G5": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "pattern": "^\\d{4}$"}},
        "G6": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "pattern": "^\\d{3}$"}},
        "G7": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "pattern": "^\\d{2}$"}}
      }
    }
  }
}
